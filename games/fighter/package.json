{
  "name": "jev-fighter",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "bench": "node --env-file-if-exists=.env --import tsx scripts/bench.ts",
    "leaderboard": "node --env-file-if-exists=.env --import tsx scripts/bench.ts --leaderboard",
    "smoke": "node --env-file-if-exists=.env --import tsx scripts/smoke.ts",
    "gen-audio": "node --env-file-if-exists=.env --import tsx scripts/gen-audio.ts",
    "official": "node --env-file-if-exists=.env --import tsx scripts/bench.ts --official",
    "replays": "node --env-file-if-exists=.env --import tsx scripts/replays.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "mediabunny": "^1.61.3",
    "tsx": "^4.23.15"
  }
}
