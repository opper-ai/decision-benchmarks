# Settings for the game service (server/main.ts) and the dev server (GAME=<slug> npm run dev). See README.md.

# Your own key, for local play and the bench: calls go through Opper with it (ignored when PUBLIC_BASE_URL is https
# unless ALLOW_DEV_KEY=1, because it would pay for every signed-out visitor)
OPPER_API_KEY=
OPPER_BASE_URL=https://api.opper.ai
# Or a TypeSafe key: Jev calls go straight to TypeSafe's System One API (Jev only; wins over OPPER_API_KEY)
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Free credits: one Opper key whose balance pays for signed-out visitors of every game until it runs out
OPPER_POOL_API_KEY=
# Proxies in front of the server that append to X-Forwarded-For (default 2 in production, else 0)
TRUSTED_PROXIES=
# Player high scores: an S3 bucket (each game's boards at [HIGHSCORES_PREFIX/]<slug>/highscores.json), else files in
# HIGHSCORES_DIR (default: the temp folder)
HIGHSCORES_BUCKET=
HIGHSCORES_PREFIX=
HIGHSCORES_DIR=

# Login with Opper: one OAuth app, with a redirect URI per game: ${PUBLIC_BASE_URL}${APP_BASE_PATH}/<slug>/auth/callback
OPPER_CLIENT_ID=
OPPER_CLIENT_SECRET=
# 32+ random characters, e.g. `openssl rand -hex 32` (required when PUBLIC_BASE_URL is https)
SESSION_SECRET=

# Where the games are served: APP_BASE_PATH (e.g. /decision-benchmarks) below PUBLIC_BASE_URL (e.g. https://opper.ai,
# empty = the dev server http://localhost:5173). APP_BASE_PATH is also baked into the pages at build time;
# VITE_PUBLIC_URL is the public origin used in share links and social-card tags (empty = https://opper.ai).
APP_BASE_PATH=
PUBLIC_BASE_URL=
VITE_PUBLIC_URL=

# The service serves games/registry.ts; GAMES=<slug>,<slug> serves those instead (e.g. GAMES=pacman locally)
GAMES=

# The bench: sent as a bearer token to your own endpoint (--endpoint)
BENCH_ENDPOINT_TOKEN=
